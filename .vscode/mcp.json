{
  "servers": {
    "codetrust": {
      "command": "uvx",
      "args": [
        "-q",
        "--no-progress",
        "--from",
        "codetrust",
        "codetrust-mcp"
      ],
      "_injectedBy": "codetrust-auto-injected",
      "_resolvedStrategy": "uvx"
    },
    "codetrust-gateway": {
      "command": "uvx",
      "args": [
        "-q",
        "--no-progress",
        "--from",
        "codetrust",
        "codetrust-gateway-mcp"
      ],
      "_injectedBy": "codetrust-auto-injected",
      "_resolvedStrategy": "uvx",
      "env": {
        "CODETRUST_WORKSPACE": "${workspaceFolder}"
      }
    }
  }
}
