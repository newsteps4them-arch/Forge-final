rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isEmailVerified() {
      return !('email' in request.auth.token) || request.auth.token.email_verified == true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isEmailVerified() && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isEmailVerified() && isValidUser(incoming()) && (
        // Action: Update Profile
        incoming().diff(existing()).affectedKeys().hasOnly([
          'assistantName', 'wakeWord', 'customVoiceEnabled', 'customVoiceUrl',
          'userName', 'apiKey', 'vehicleYear', 'vehicleMake', 'vehicleModel',
          'vehicleVin', 'vehicleProtocol', 'vehicleInfo', 'inventory',
          'meliApiKey', 'alldataKey', 'obdKey', 'openAiKey', 'onboardingComplete',
          'email', 'updatedAt'
        ])
      );

      function isValidUser(data) {
        return data.keys().hasAll(['userName', 'onboardingComplete']) &&
               data.keys().hasOnly([
                 'assistantName', 'wakeWord', 'customVoiceEnabled', 'customVoiceUrl',
                 'userName', 'apiKey', 'vehicleYear', 'vehicleMake', 'vehicleModel',
                 'vehicleVin', 'vehicleProtocol', 'vehicleInfo', 'inventory',
                 'meliApiKey', 'alldataKey', 'obdKey', 'openAiKey', 'onboardingComplete',
                 'email', 'updatedAt'
               ]) &&
               data.userName is string && data.userName.size() <= 100 &&
               data.onboardingComplete is bool &&
               (data.assistantName == null || (data.assistantName is string && data.assistantName.size() <= 100)) &&
               (data.wakeWord == null || (data.wakeWord is string && data.wakeWord.size() <= 100)) &&
               (data.customVoiceEnabled == null || data.customVoiceEnabled is bool) &&
               (data.customVoiceUrl == null || (data.customVoiceUrl is string && data.customVoiceUrl.size() <= 2048)) &&
               (data.apiKey == null || (data.apiKey is string && data.apiKey.size() <= 512)) &&
               (data.vehicleYear == null || (data.vehicleYear is string && data.vehicleYear.size() <= 10)) &&
               (data.vehicleMake == null || (data.vehicleMake is string && data.vehicleMake.size() <= 50)) &&
               (data.vehicleModel == null || (data.vehicleModel is string && data.vehicleModel.size() <= 50)) &&
               (data.vehicleVin == null || (data.vehicleVin is string && data.vehicleVin.size() <= 17)) &&
               (data.vehicleProtocol == null || (data.vehicleProtocol is string && data.vehicleProtocol.size() <= 50)) &&
               (data.vehicleInfo == null || (data.vehicleInfo is string && data.vehicleInfo.size() <= 2000)) &&
               (data.inventory == null || (data.inventory is string && data.inventory.size() <= 10000)) &&
               (data.meliApiKey == null || (data.meliApiKey is string && data.meliApiKey.size() <= 512)) &&
               (data.alldataKey == null || (data.alldataKey is string && data.alldataKey.size() <= 512)) &&
               (data.obdKey == null || (data.obdKey is string && data.obdKey.size() <= 512)) &&
               (data.openAiKey == null || (data.openAiKey is string && data.openAiKey.size() <= 512)) &&
               (data.email == null || (data.email is string && data.email.size() <= 200)) &&
               (data.updatedAt == null || data.updatedAt == request.time);
      }
    }

    // --- Projects Collection ---
    match /projects/{projectId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(projectId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && isEmailVerified() &&
                      incoming().userId == request.auth.uid && 
                      isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && isEmailVerified() &&
                      existing().userId == request.auth.uid && 
                      incoming().userId == request.auth.uid && 
                      isValidProject(incoming()) && (
                        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'color', 'updatedAt'])
                      );
      allow delete: if isSignedIn() && isValidId(projectId) && existing().userId == request.auth.uid;

      function isValidProject(data) {
        return data.keys().hasAll(['name', 'userId']) &&
               data.keys().hasOnly(['name', 'description', 'userId', 'color', 'createdAt', 'updatedAt']) &&
               data.name is string && data.name.size() <= 100 &&
               data.userId == request.auth.uid &&
               (data.description == null || (data.description is string && data.description.size() <= 1000)) &&
               (data.color == null || (data.color is string && data.color.size() <= 20)) &&
               (data.createdAt == null || (data.createdAt is timestamp && data.createdAt == request.time) || (data.createdAt is int && data.createdAt == request.time.toMillis())) &&
               (data.updatedAt == null || data.updatedAt == request.time);
      }
    }

    // --- Tasks Collection ---
    match /tasks/{taskId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(taskId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId) && isEmailVerified() &&
                      incoming().userId == request.auth.uid && 
                      isValidTask(incoming());
      allow update: if isSignedIn() && isValidId(taskId) && isEmailVerified() &&
                      existing().userId == request.auth.uid && 
                      incoming().userId == request.auth.uid && 
                      isValidTask(incoming()) && (
                        // Action: Edit Task
                        incoming().diff(existing()).affectedKeys().hasOnly(['text', 'completed', 'category', 'priority', 'dueDate', 'updatedAt'])
                      );
      allow delete: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;

      function isValidTask(data) {
        return data.keys().hasAll(['text', 'completed', 'userId', 'priority']) &&
               data.keys().hasOnly(['text', 'completed', 'userId', 'priority', 'category', 'dueDate', 'createdAt', 'updatedAt', 'projectId']) &&
               data.text is string && data.text.size() <= 1000 &&
               data.completed is bool &&
               data.userId == request.auth.uid &&
               data.priority in ['Low', 'Medium', 'High'] &&
               (data.category == null || (data.category is string && data.category.size() <= 50)) &&
               (data.dueDate == null || (data.dueDate is string && data.dueDate.size() <= 20)) &&
               (data.createdAt == null || (data.createdAt is timestamp && data.createdAt == request.time) || (data.createdAt is int && data.createdAt == request.time.toMillis())) &&
               (data.updatedAt == null || data.updatedAt == request.time) &&
               (data.projectId == null || (data.projectId is string && isValidId(data.projectId) && get(/databases/$(database)/documents/projects/$(data.projectId)).data.userId == request.auth.uid));
      }
    }

    // --- Chat Collection ---
    match /chats/{chatId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(chatId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(chatId) && isEmailVerified() &&
                      incoming().userId == request.auth.uid && 
                      isValidChat(incoming());

      function isValidChat(data) {
        return data.keys().hasAll(['role', 'text', 'userId', 'projectId']) &&
               data.keys().hasOnly(['role', 'text', 'userId', 'projectId', 'image', 'timestamp']) &&
               data.role in ['user', 'model'] &&
               data.text is string && data.text.size() <= 10000 &&
               data.userId == request.auth.uid &&
               data.projectId is string && isValidId(data.projectId) &&
               (data.image == null || (data.image is string && data.image.size() <= 1000000)) &&
               (data.timestamp == null || (data.timestamp is timestamp && data.timestamp == request.time) || (data.timestamp is int && data.timestamp == request.time.toMillis()));
      }
    }

    // --- Inventory Collection ---
    match /inventory/{itemId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(itemId) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(itemId) && isEmailVerified() &&
                      incoming().userId == request.auth.uid && 
                      isValidItem(incoming());
      allow update: if isSignedIn() && isValidId(itemId) && isEmailVerified() &&
                      existing().userId == request.auth.uid && 
                      incoming().userId == request.auth.uid && 
                      isValidItem(incoming());
      allow delete: if isSignedIn() && isValidId(itemId) && existing().userId == request.auth.uid;

      function isValidItem(data) {
        return data.keys().hasAll(['name', 'quantity', 'userId']) &&
               data.keys().hasOnly(['name', 'quantity', 'userId', 'category']) &&
               data.name is string && data.name.size() <= 100 &&
               data.quantity is int &&
               data.userId == request.auth.uid &&
               (data.category == null || (data.category is string && data.category.size() <= 100));
      }
    }

    // --- Leads Collection ---
    match /leads/{leadId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(leadId);
      allow create: if isSignedIn() && isValidId(leadId) && isEmailVerified() && isValidLead(incoming());

      function isValidLead(data) {
        return data.keys().hasAll(['name', 'email', 'business', 'interest', 'timestamp']) &&
               data.keys().hasOnly(['name', 'email', 'business', 'interest', 'timestamp']) &&
               data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 200 &&
               data.business is string && data.business.size() <= 200 &&
               data.interest is string && data.interest.size() <= 100 &&
               data.timestamp is string && data.timestamp.size() <= 50;
      }
    }
  }
}
